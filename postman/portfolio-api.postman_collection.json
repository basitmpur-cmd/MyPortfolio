    },
    {
      "name": "4 REJECTED - create project with no token (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Full-Stack Portfolio\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"MERN portfolio with JWT authentication and role-based CRUD.\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "5 REJECTED - create project as regular user (403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Full-Stack Portfolio\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"MERN portfolio with JWT authentication and role-based CRUD.\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "6 Admin create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Full-Stack Portfolio\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"MERN portfolio with JWT authentication and role-based CRUD.\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json(); if (d._id) pm.collectionVariables.set('projectId', d._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7 List projects (public)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/projects",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "8 Admin update project",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/projects/{{projectId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Full-Stack Portfolio (updated)\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "9 Admin delete project",
      "request": {
        "method": "DELETE",
