# Copy to .env and fill in your own values. .env is git-ignored and must never be committed.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# Administrator created on start-up if it does not exist yet.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
# bcrypt hash made with: npm run hash -- "YourAdminPassword"   (keep the single quotes)
ADMIN_PASSWORD_HASH=''
